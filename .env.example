PARSER_MODE=offline
LLM_PROVIDER=openrouter
LLM_MODEL=openrouter/free
OPENROUTER_API_KEY=
OPENROUTER_FALLBACK_MODELS=nex-agi/nex-n2.5-mini:free,nvidia/nemotron-3.5-lightning:free,google/gemma-4-26b-a4b-it:free
GEMINI_API_KEY=
